# ============================================================================
# FinPolicy Compiler — Backend Environment Variables Template (Supabase Cloud)
# ============================================================================

NODE_ENV=development
PORT=5000
API_VERSION=v1

# Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.poxgtwnbbdczrtvwcilv.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.poxgtwnbbdczrtvwcilv.supabase.co:5432/postgres"

# Supabase Project Configuration
SUPABASE_URL="https://poxgtwnbbdczrtvwcilv.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Security
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application Security & CORS
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Compiler & Execution Limits
MAX_COMPILATION_TIMEOUT_MS=10000
MAX_EXECUTION_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
