{
  "name": "finpolicy-backend",
  "version": "1.0.0",
  "description": "FinPolicy Compiler Backend API (Supabase + Prisma)",
  "main": "dist/server.js",
  "prisma": {
    "schema": "../database/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --coverage",
    "db:migrate": "prisma migrate dev --schema=../database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=../database/prisma/schema.prisma"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@finpolicy/compiler": "*",
    "@prisma/client": "^5.19.0",
    "@supabase/supabase-js": "^2.45.4",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "winston": "^3.14.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "date-fns": "^3.6.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^10.0.0",
    "@types/compression": "^1.7.5",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "prisma": "^5.19.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13",
    "ts-jest": "^29.2.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.9.0"
  }
}
