POLICY ScholarshipAidApprove
INPUT
  gpa: decimal
  familyIncome: decimal
  communityHours: int
OUTPUT
  scholarshipAmount: decimal
  reviewScore: int
WHEN
  gpa >= 8.5 AND familyIncome <= 45000 AND communityHours >= 40
THEN
  APPROVE
  SET scholarshipAmount = 25000
  SET reviewScore = 95
ELSE
  REVIEW
  SET scholarshipAmount = 5000
  SET reviewScore = 60
END
