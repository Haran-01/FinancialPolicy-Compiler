{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "..",
    "composite": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@finpolicy/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../shared/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "src/**/*.d.ts"]
}
